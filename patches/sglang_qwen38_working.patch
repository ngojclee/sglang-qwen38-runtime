+def unpack_4bit_gdn(packed_w: torch.Tensor, scale: torch.Tensor, group_size: int = 128) -> torch.Tensor:
+    N, K_packed = packed_w.shape
+    orig_shape = torch.Size([N, K_packed * 8])
+    unpacked = unpack_from_int32(packed_w, num_bits=4, shape=orig_shape, packed_dim=1)
+    scale_expanded = scale.repeat_interleave(group_size, dim=1)
+    return unpacked.to(scale.dtype) * scale_expanded
